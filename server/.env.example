# Environment Variables Configuration
# Copy this file to .env and update with your values

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/smart-waste-bin
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/smart-waste-bin

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# API Key for Bin Nodes
API_KEY=your-secure-api-key-for-bin-communication

# Dashboard URL (for CORS)
DASHBOARD_URL=http://localhost:3001

# Optional: Email Configuration (for alerts)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Optional: SMS Configuration (for alerts)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
